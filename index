// ============================================================
// Number animation (always lands on the final value)
// ============================================================
function animateText(el, to, decimals){
  const from = parseFloat(el.dataset.raw || "0");
  el.dataset.raw = to;
  const id = (el._a = (el._a || 0) + 1);
  clearTimeout(el._t);
  if (REDUCED || from === to){ el.textContent = to.toFixed(decimals); return; }
  const start = performance.now(), dur = 420;
  function tick(now){
    if (el._a !== id) return;
    const t = Math.min(1, (now - start) / dur);
    const eased = 1 - Math.pow(1 - t, 3);
    el.textContent = (from + (to - from) * eased).toFixed(decimals);
    if (t < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
  el._t = setTimeout(() => { if (el._a === id) el.textContent = to.toFixed(decimals); }, dur + 140);
}

// ============================================================
// Master compute
// ============================================================
function readAux(key, k){
  const el = document.querySelector(`.aux-item[data-key="${key}"] [data-k="${k}"]`);
  return el ? el.value : null;
}

function compute(){
  const proc = PROCESSES[state.processIdx];
  const mat = MATERIALS[state.materialIdx];
  const dim = parseFloat($("baseDim").value) || 0;

  const shrinkAdd = dim * (mat.shrink / 1000);
  let running = dim + shrinkAdd;
  const machAdd = machiningTable(dim, state.surface);
  running += machAdd;

  const distortPct = parseFloat($("shape").value);
  const distortAdd = proc.ok.distortion ? running * (distortPct / 100) : 0;
  running += distortAdd;

  let shakeSub = 0;
  $("shakeInputs").style.display = proc.ok.shake ? "block" : "none";
  if (proc.ok.shake){
    const pct = shakePct(state.molding, state.size);
    shakeSub = running * (pct / 100);
    running -= shakeSub;
  }
  const final = running;

  // Chain strip
  const chain = $("chain");
  const nodes = [
    ["Basic", dim, false],
    ["Shrink", shrinkAdd, false],
    ["Machine", machAdd, false],
  ];
  if (proc.ok.distortion) nodes.push(["Distort", distortAdd, false]);
  if (proc.ok.shake) nodes.push(["Shake", -shakeSub, true]);
  if (!chain.dataset.built || chain.dataset.built !== String(nodes.length)){
    let html = "";
    nodes.forEach((n, i) => {
      if (i > 0) html += `<span class="chain-arrow">→</span>`;
      html += `<div class="chain-node${n[2]?' neg':''}"><div class="k">${n[0]}</div><div class="v" data-node="${i}">0.00</div></div>`;
    });
    html += `<span class="chain-arrow">=</span><div class="chain-node final"><div class="k">Final</div><div class="v" data-node="final">0.00</div></div>`;
    chain.innerHTML = html;
    chain.dataset.built = String(nodes.length);
  }
  nodes.forEach((n, i) => {
    const el = chain.querySelector(`[data-node="${i}"]`);
    if (el) animateText(el, n[1], 2);
  });
  animateText(chain.querySelector('[data-node="final"]'), final, 2);

  // Auxiliary results
  const results = {};
  if (proc.ok.draft){
    const h = parseFloat(readAux("draft","draftHeight")) || 0;
    const a = parseFloat(readAux("draft","draftAngle")) || 0;
    const add = h * Math.tan(a * Math.PI/180);
    results.draft = { text:`${a}° over ${h} mm → <b>${add.toFixed(2)} mm</b> extra at the far face.`, val:add.toFixed(2)+" mm" };
  }
  if (proc.ok.corePrint){
    const dia = parseFloat(readAux("corePrint","coreDia")) || 0;
    const base = corePrintLen(dia);
    if (state.coreOrient === "horizontal"){
      results.corePrint = { text:`⌀${dia} mm horizontal core → <b>${base} mm</b> print at each end.`, val:base+" mm" };
    } else {
      const top = Math.round(base*0.6);
      results.corePrint = { text:`⌀${dia} mm vertical core → bottom <b>${base} mm</b>, top <b>${top} mm</b>.`, val:`${base}/${top} mm` };
    }
  }
  if (proc.ok.riser){
    const V = parseFloat(readAux("riser","castVol")) || 0;
    const A = parseFloat(readAux("riser","castArea")) || 1;
    const Mc = V/A, Mr = 1.2*Mc, D = 6*Mr, H = D, Vr = Math.PI*D*D*H/4;
    results.riser = { text:`Modulus ${Mc.toFixed(2)}→${Mr.toFixed(2)} cm → riser <b>${(D*10).toFixed(0)}×${(H*10).toFixed(0)} mm</b> (${Vr.toFixed(0)} cm³).`, val:`${(D*10).toFixed(0)}×${(H*10).toFixed(0)} mm` };
  }
  if (proc.ok.chaplet){
    const w = parseFloat(readAux("chaplet","coreWeight")) || 0;
    const [cd, stock] = chapletSpec(w);
    results.chaplet = { text:`${w} kg core → <b>⌀${cd} mm</b> chaplet, <b>${stock} mm</b> cleanup stock at the head.`, val:`⌀${cd} mm` };
  }
  results.fettling = { text:`${proc.name} → <b>${proc.fettlingMm} mm</b> extra stock at the parting line / flash.`, val:proc.fettlingMm+" mm" };
  if (proc.ok.wear){
    const pm = readAux("wear","patternMat") || "wood";
    const pct = pm === "wood" ? 0.30 : pm === "metal" ? 0.05 : 0.10;
    const add = dim * (pct/100);
    results.wear = { text:`${pm[0].toUpperCase()+pm.slice(1)} pattern → <b>${add.toFixed(3)} mm</b> suggested oversize.`, val:add.toFixed(2)+" mm" };
  }

  Object.keys(results).forEach(key => {
    const valEl = document.querySelector(`[data-val="${key}"]`);
    const resEl = document.querySelector(`[data-result="${key}"]`);
    if (valEl) valEl.textContent = results[key].val;
    if (resEl) resEl.innerHTML = results[key].text;
  });

  // Dock
  animateText($("dockVal"), final, 2);
  const segs = [
    { v: Math.abs(shrinkAdd), c: "#FFFFFF" },
    { v: Math.abs(machAdd), c: "#BDBDBD" },
    { v: Math.abs(distortAdd), c: "#808080" },
    { v: Math.abs(shakeSub), c: "#4D4D4D" },
  ];
  const tot = segs.reduce((s,x)=>s+x.v,0) || 1;
  $("dockBar").innerHTML = segs.map(s =>
    `<span style="width:${(s.v/tot*100).toFixed(1)}%; background:${s.c}"></span>`).join("");

  // Full breakdown sheet
  $("breakdownChain").innerHTML = [
    ["Basic (finished) dimension", dim.toFixed(2)+" mm"],
    [`+ Shrinkage (${mat.shrink} mm/m, ${mat.name})`, "+"+shrinkAdd.toFixed(2)+" mm"],
    [`+ Machining (${state.surface} surface)`, "+"+machAdd.toFixed(2)+" mm"],
    proc.ok.distortion ? [`+ Distortion (${distortPct}%)`, "+"+distortAdd.toFixed(2)+" mm"] : ["Distortion", "Not applicable"],
    proc.ok.shake ? ["− Shake correction", "−"+shakeSub.toFixed(2)+" mm"] : ["Shake correction", "Not applicable"],
    ["Final pattern dimension", final.toFixed(2)+" mm"],
  ].map(r => `<div class="b-row"><span class="k">${r[0]}</span><span class="v">${r[1]}</span></div>`).join("");

  $("breakdownAux").innerHTML = AUX_DEFS.map(def => {
    if (def.key !== "fettling" && !proc.ok[def.key]) return `<div class="b-row"><span class="k">${def.name}</span><span class="v">Not applicable</span></div>`;
    return `<div class="b-row"><span class="k">${def.name}</span><span class="v">${results[def.key] ? results[def.key].val : "—"}</span></div>`;
  }).join("");

  document.dispatchEvent(new CustomEvent("calc:update", { detail:{ dim, shrinkAdd, machAdd, distortAdd, distortPct, shakeSub, final, proc, mat, results } }));
}


