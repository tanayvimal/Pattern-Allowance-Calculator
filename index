    <tr><th scope="row">Drawing dimension</th><td>${f2(CASE.dim)}</td><td>${f2(CASE.dim)}</td></tr>
    <tr><th scope="row">Shrinkage</th><td>${sg(rs)}</td><td>${sg(c.shrink)}</td></tr>
    <tr><th scope="row">Machining</th><td>${sg(rm)}</td><td>${sg(c.mach)}</td></tr>
    <tr><th scope="row">Distortion</th><td class="na">not applied</td><td>${sg(c.distort)}</td></tr>
    <tr><th scope="row">Shake</th><td class="na">not applied</td><td>${sg(-c.shake)}</td></tr>
    <tr class="total"><th scope="row">Pattern size</th><td>${f2(rule)}</td><td>${f2(c.final)}</td></tr>`;
  const gap = c.final - rule, left = c.mach - gap, v = $("verdict");
