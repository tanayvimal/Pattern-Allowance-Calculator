// Hero readout + steps
function updatePage(s){
  const proc = s.proc, mat = s.mat;
  $("heroDrawing").textContent = f2(s.dim);
  $("heroPattern").textContent = f2(s.final);
  const delta = s.final - s.dim, pct = s.dim ? delta / s.dim * 100 : 0;
  $("heroDelta").textContent = `${delta >= 0 ? "+" : "−"}${f2(Math.abs(delta))} mm  (${pct >= 0 ? "+" : "−"}${Math.abs(pct).toFixed(1)}%)`;
  $("heroMeta").textContent = `${proc.name} · ${mat.name}`;

  const cells = [
    ["Drawing", f2(s.dim), true],
    ["Shrinkage", sg(s.shrinkAdd), true],
    ["Machining", s.machAdd ? sg(s.machAdd) : "0.00", true],
    ["Distortion", proc.ok.distortion ? sg(s.distortAdd) : "n/a", proc.ok.distortion],
    ["Shake", proc.ok.shake ? (s.shakeSub ? sg(-s.shakeSub) : "0.00") : "n/a", proc.ok.shake],
  ];
  $("stepsRow").innerHTML = cells.map(c => `<div class="step${c[2] ? "" : " off"}"><span>${c[0]}</span><b>${c[1]}</b></div>`).join("")
    + `<div class="step final"><span>Pattern</span><b>${f2(s.final)}</b></div>`;
}
