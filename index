const MACH = [[150,1.5,3],[300,3,4.5],[500,4,5.5],[900,5.5,7],[1500,7,9],[Infinity,9,12]];
const MACH_LABELS = ["Up to 150 mm","151 to 300 mm","301 to 500 mm","501 to 900 mm","901 to 1500 mm","Over 1500 mm"];

function machRowIndex(dim){ return MACH.findIndex(r => dim <= r[0]); }
function machiningTable(dim, surface){
  if (surface === "none") return 0;
  const r = MACH[machRowIndex(dim)];
  return surface === "top" ? r[2] : r[1];
}
function corePrintLen(d){
  if (d<=25) return 10; if (d<=50) return 15; if (d<=75) return 20;
  if (d<=100) return 25; if (d<=150) return 30; if (d<=200) return 40; return 50;
}
function chapletSpec(w){
  if (w<=5) return [6,1.5]; if (w<=15) return [10,2.0]; if (w<=40) return [16,2.5];
  if (w<=100) return [22,3.0]; return [30,4.0];
}
function shakePct(molding, size){
  if (molding === "machine") return 0;
  return size === "large" ? 1.0 : 0.5;
}

