    v.className = "verdict ok";
    v.innerHTML = `<strong>The rule is large enough here</strong>It gives ${f2(rule)} mm, at or above the calculator's ${f2(c.final)} mm.`;
  } else if (left <= 0){
    v.className = "verdict";
    v.innerHTML = `<strong>The pattern is ${f2(gap)} mm too small</strong>The machining stock on this face is only ${f2(c.mach)} mm, so it is used up before the first cut and the casting is scrapped.`;
  } else {
    v.className = "verdict";
    v.innerHTML = `<strong>The pattern is ${f2(gap)} mm too small</strong>Only about ${f2(left)} mm of the ${f2(c.mach)} mm machining stock would be left.`;
  }
}
