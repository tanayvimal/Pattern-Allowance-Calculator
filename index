const root = document.documentElement;
const f2 = n => (Math.abs(n) < 0.005 ? 0 : n).toFixed(2);
const sg = n => (n < 0 ? "−" : "+") + f2(Math.abs(n));
const procBy = abbr => PROCESSES.find(p => p.abbr === abbr);
const matBy = name => MATERIALS.find(m => m.name === name);
let lastCalc = null;

function engine(proc, mat, dim, surface, shapePct, molding, size){
  const shrink = dim * mat.shrink / 1000;
  let run = dim + shrink;
  const mach = machiningTable(dim, surface);
  run += mach;
  const distort = proc.ok.distortion ? run * shapePct / 100 : 0;
  run += distort;
  let shake = 0;
  if (proc.ok.shake){ shake = run * shakePct(molding, size) / 100; run -= shake; }
  return { shrink, mach, distort, shake, final: run };
}

let toastTimer;
function toast(msg){
  const t = $("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 2400);
}

