<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Pattern Allowance Calculator</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add("js");</script>
<style>
  /* Layout: full-width bands on a 1200px column. Hero pairs the thesis with the working calculator, a dark band carries the worked
     example, and every section reads from the same calculator state. Sharp 2px corners, hairline rules, one orange accent. */
  :root{
    --ground:#FFFFFF; --surface:#FFFFFF; --surface-2:#F0F0F0; --rule:#BDBDBD;
    --ink:#000000; --ink-dim:#4A4A4A;
    --accent:#000000; --accent-ink:#000000; --accent-soft:rgba(0,0,0,.07); --on-accent:#FFFFFF;
    --teal:#444444; --blue:#8C8C8C; --loss:#666666; --grid:rgba(0,0,0,.06);
    --s1:#000000; --s2:#555555; --s3:#999999; --s4:#D0D0D0;
    --display:'Archivo','Arial Narrow',system-ui,sans-serif;
    --body:'Source Sans 3',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,monospace;
    color-scheme:light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ground:#000000; --surface:#0A0A0A; --surface-2:#161616; --rule:#333333;
      --ink:#FFFFFF; --ink-dim:#A6A6A6;
      --accent:#FFFFFF; --accent-ink:#FFFFFF; --accent-soft:rgba(255,255,255,.12); --on-accent:#000000;
      --teal:#BDBDBD; --blue:#8A8A8A; --loss:#A6A6A6; --grid:rgba(255,255,255,.05);
      --s1:#FFFFFF; --s2:#BDBDBD; --s3:#808080; --s4:#444444;
      color-scheme:dark;
    }
  }
  :root[data-theme="dark"]{
    --ground:#000000; --surface:#0A0A0A; --surface-2:#161616; --rule:#333333;
    --ink:#FFFFFF; --ink-dim:#A6A6A6;
    --accent:#FFFFFF; --accent-ink:#FFFFFF; --accent-soft:rgba(255,255,255,.12); --on-accent:#000000;
    --teal:#BDBDBD; --blue:#8A8A8A; --loss:#A6A6A6; --grid:rgba(255,255,255,.05);
      --s1:#FFFFFF; --s2:#BDBDBD; --s3:#808080; --s4:#444444;
    color-scheme:dark;
  }

  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth; scroll-padding-top:76px;}
  body{background:var(--ground); color:var(--ink); font-family:var(--body); font-size:17px; line-height:1.55; -webkit-font-smoothing:antialiased;}
  body::before{content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top,0px); background:var(--ground); z-index:60;}
  ::selection{background:var(--accent-soft); color:var(--accent-ink);}
  a{color:inherit;}
  :focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  .sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;}
  h1,h2,h3,h4{font-family:var(--display); text-wrap:balance; margin:0;}
  p{margin:0;}

  .wrap{max-width:1200px; margin:0 auto; padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));}
  .page{max-width:1200px; margin:0 auto; padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));}
  .sec{max-width:1200px; margin:0 auto; padding-block:88px;
    padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));}
  .sec + .sec{border-top:1px solid var(--rule);}
  .sec > *, .wrap > *{min-width:0;}
  .kicker{display:flex; align-items:center; gap:10px; font-family:var(--display); font-weight:600; font-size:12.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent-ink); margin:0 0 14px;}
  .kicker::before{content:""; width:9px; height:9px; background:var(--accent); flex:0 0 auto;}
  h2{font-weight:700; font-size:clamp(28px,3.9vw,44px); line-height:1.05; letter-spacing:-.015em; margin-bottom:16px;}
  .lead{color:var(--ink-dim); font-size:clamp(17px,1.8vw,19px); line-height:1.6; max-width:64ch;}
  .sec-head{margin-bottom:44px;}
  .fine{font-size:14px; color:var(--ink-dim); margin:20px 0 0; max-width:72ch;}

  /* ---------- Top bar ---------- */
  .top{position:sticky; top:env(safe-area-inset-top,0px); z-index:50; background:var(--surface); border-bottom:1px solid var(--rule);}
  .top-in{max-width:1200px; margin:0 auto; display:flex; align-items:center; gap:18px; padding-block:9px;
    padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));}
  .brand{display:flex; align-items:center; gap:10px; font-family:var(--display); font-weight:800; font-size:16px; letter-spacing:-.01em; text-decoration:none; white-space:nowrap;}
  .brand svg{width:24px; height:24px; stroke:var(--accent); fill:none; stroke-width:1.8; stroke-linecap:square;}
  .top nav{display:flex; gap:2px; overflow-x:auto; scrollbar-width:none; min-width:0; flex:1;}
  .top nav::-webkit-scrollbar{display:none;}
  .top nav a{font-family:var(--display); font-weight:600; font-size:14px; text-decoration:none; color:var(--ink-dim); padding:10px 12px; white-space:nowrap; transition:color .2s;}
  .top nav a:hover{color:var(--ink);}
  .top nav a.active{color:var(--ink); box-shadow:inset 0 -3px 0 var(--accent);}
  .tbtn{font-family:var(--display); font-weight:600; font-size:13px; letter-spacing:.04em; color:var(--ink); background:transparent; border:1px solid var(--rule); padding:8px 12px; cursor:pointer; flex:0 0 auto;}
  .tbtn:hover{border-color:var(--ink);}
  .progress{position:absolute; left:0; right:0; bottom:-1px; height:3px; pointer-events:none;}
  .progress i{display:block; height:100%; background:var(--accent); transform-origin:0 50%; transform:scaleX(0);}
  @media (max-width:700px){ .brand span{display:none;} }

  /* ---------- Hero ---------- */
  .hero-band{position:relative; border-bottom:1px solid var(--rule); background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px); background-size:44px 44px; background-position:-1px -1px;}
  .hero-band::after{content:""; position:absolute; left:0; right:0; bottom:0; height:140px; background:linear-gradient(to bottom,transparent,var(--ground)); pointer-events:none;}
  .hero{position:relative; z-index:1; display:grid; grid-template-columns:minmax(0,1fr); gap:48px; padding-block:56px 80px; align-items:start;}
  @media (min-width:940px){ .hero{grid-template-columns:minmax(0,1fr) 420px; gap:72px; padding-block:76px 96px;} }
  h1{font-weight:800; font-size:clamp(40px,6.6vw,78px); line-height:.98; letter-spacing:-.025em; margin:0 0 22px;}
  .readout{display:flex; flex-wrap:wrap; align-items:flex-end; gap:12px 24px; margin:36px 0 10px; padding:22px 0 0; border-top:2px solid var(--ink);}
  .r-block{display:flex; flex-direction:column; gap:2px; min-width:0;}
  .r-label{font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-dim);}
  .r-val{font-family:var(--mono); font-weight:600; font-variant-numeric:tabular-nums; display:flex; align-items:baseline; gap:6px;}
  .r-val .n{font-size:clamp(24px,3.6vw,32px); color:var(--ink);}
  .r-val.big .n{font-size:clamp(42px,7vw,68px); line-height:1; color:var(--accent-ink);}
  .r-val .u{font-size:14px; color:var(--ink-dim); font-weight:500;}
  .r-arrow{font-size:26px; color:var(--ink-dim); align-self:center; padding-bottom:6px;}
  .r-delta{font-family:var(--mono); font-size:14px; color:var(--accent-ink); font-variant-numeric:tabular-nums; font-weight:600;}
  .hero-meta-line{font-family:var(--mono); font-size:12.5px; color:var(--ink-dim); margin:6px 0 0;}
  .comp-title{font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-dim); margin:26px 0 8px;}
  .comp{display:flex; height:12px; gap:2px; background:transparent;}
  .comp span{height:100%; min-width:0; transition:width .5s cubic-bezier(.2,.8,.2,1);}
  .legend{display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:8px 18px; margin-top:12px;}
  .lg{display:flex; align-items:baseline; gap:8px; font-size:14px; color:var(--ink-dim); min-width:0;}
  .lg i{width:10px; height:10px; flex:0 0 auto; align-self:center;}
  .lg b{font-family:var(--mono); font-weight:600; color:var(--ink); font-size:13px; margin-left:auto; font-variant-numeric:tabular-nums;}
  .actions{display:flex; flex-wrap:wrap; gap:10px; margin-top:28px;}
  .hint{color:var(--ink-dim); font-size:15px; max-width:54ch; margin-top:20px;}
  .hero-demo{min-width:0; display:flex; justify-content:center;}

  /* ---------- Buttons ---------- */
  .btn{font-family:var(--display); font-weight:700; font-size:14px; letter-spacing:.02em; background:var(--accent); color:var(--on-accent); border:1px solid var(--accent); border-radius:2px; padding:11px 18px; cursor:pointer; transition:transform .15s, filter .15s;}
  .btn:hover{filter:brightness(1.08); transform:translateY(-1px);}
  .btn.ghost{background:transparent; color:var(--ink); border-color:var(--ink);}
  .btn.ghost:hover{background:var(--ink); color:var(--ground); filter:none;}

  /* ---------- Worked example (dark band) ---------- */
  .band-dark{--ink:#FFFFFF; --ink-dim:#A6A6A6; --rule:#333333; --surface:#0D0D0D; --surface-2:#1A1A1A;
    --accent:#FFFFFF; --accent-ink:#FFFFFF; --accent-soft:rgba(255,255,255,.14); --on-accent:#000000; --teal:#BDBDBD; --loss:#A6A6A6;
    background:#000000; color:var(--ink); border-block:1px solid #2A2A2A; color-scheme:dark;}
  .band-dark .lead{color:var(--ink-dim);}
  .case{display:grid; grid-template-columns:minmax(0,1fr); gap:48px; padding-block:96px;}
  @media (min-width:980px){ .case{grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:72px;} }
  .facts{margin:26px 0 0; border-top:1px solid var(--rule);}
  .facts .row{display:flex; justify-content:space-between; gap:16px; padding:11px 0; border-bottom:1px solid var(--rule); font-size:15px;}
  .facts dt{color:var(--ink-dim); margin:0;}
  .facts dd{margin:0; font-family:var(--mono); font-weight:600; font-size:13.5px; text-align:right;}
  .band-dark .actions{margin-top:26px;}
  .band-dark .btn.ghost{color:var(--ink); border-color:var(--ink);}
  .band-dark .btn.ghost:hover{background:var(--ink); color:#000000;}
  .cmp-box{background:var(--surface); border:1px solid var(--rule); padding:26px 26px 28px; min-width:0;}
  .cmp-top{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px 20px; margin-bottom:18px;}
  .cmp-top h3{font-weight:700; font-size:20px;}
  .hseg{display:flex; align-items:center; gap:6px; font-size:13px; color:var(--ink-dim);}
  .hseg button{font-family:var(--mono); font-weight:600; font-size:12.5px; background:transparent; color:var(--ink-dim); border:1px solid var(--rule); padding:6px 10px; cursor:pointer;}
  .hseg button[aria-pressed="true"]{background:var(--accent); border-color:var(--accent); color:var(--on-accent);}
  .cmp-scroll{overflow-x:auto;}
  table.cmp{width:100%; min-width:430px; border-collapse:collapse; font-size:15px;}
  .cmp th,.cmp td{padding:11px 10px; border-bottom:1px solid var(--rule); text-align:right; font-variant-numeric:tabular-nums;}
  .cmp th:first-child,.cmp td:first-child{text-align:left; padding-left:0;}
  .cmp thead th{font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-dim);}
  .cmp tbody th{font-weight:400; color:var(--ink);}
  .cmp td{font-family:var(--mono); font-weight:600; font-size:14px;}
  .cmp td.na{color:var(--ink-dim); font-weight:500;}
  .cmp tr.total th,.cmp tr.total td{border-bottom:none; border-top:2px solid var(--ink-dim); padding-top:14px;}
  .cmp tr.total td{font-size:18px;}
  .cmp tr.total td:last-child{color:var(--accent-ink);}
  .gapbars{margin-top:22px; display:flex; flex-direction:column; gap:10px;}
  .gb{display:grid; grid-template-columns:96px minmax(0,1fr) 84px; gap:12px; align-items:center; font-size:13px;}
  .gb span:first-child{color:var(--ink-dim); font-family:var(--display); font-weight:600; letter-spacing:.06em; text-transform:uppercase; font-size:11.5px;}
  .gb .tr{height:14px; background:var(--surface-2); position:relative;}
  .gb .tr i{position:absolute; left:0; top:0; bottom:0; background:var(--ink-dim); transition:width .5s cubic-bezier(.2,.8,.2,1);}
  .gb.calc-row .tr i{background:var(--accent);}
  .gb b{font-family:var(--mono); font-weight:600; font-size:13px; text-align:right;}
  .gb-note{font-size:12.5px; color:var(--ink-dim); margin-top:2px;}
  .verdict{margin-top:22px; border:1px solid var(--loss); background:rgba(255,255,255,.07); padding:16px 18px; font-size:15.5px; line-height:1.5;}
  .verdict strong{color:var(--loss); font-family:var(--display); font-weight:700; font-size:17px; display:block; margin-bottom:2px;}
  .verdict.ok{border-color:var(--teal); background:rgba(255,255,255,.05);}
  .verdict.ok strong{color:var(--teal);}

  /* ---------- Modal + toast ---------- */
  .modal{position:fixed; inset:0; z-index:70; display:grid; place-items:center; padding:16px;}
  .modal[hidden]{display:none !important;}
  .m-back{position:absolute; inset:0; background:rgba(6,12,20,.6); opacity:0; transition:opacity .25s;}
  .m-panel{position:relative; width:100%; max-width:580px; max-height:calc(100% - 8px); overflow:auto; background:var(--surface); border:1px solid var(--rule); border-top:4px solid var(--accent); padding:30px 30px 28px;
    opacity:0; transform:translateY(18px) scale(.97); transition:opacity .28s, transform .32s cubic-bezier(.2,.8,.2,1); box-shadow:0 24px 60px rgba(0,0,0,.28);}
  .modal.open .m-back{opacity:1;}
  .modal.open .m-panel{opacity:1; transform:none;}
  .m-close{position:absolute; top:10px; right:10px; width:36px; height:36px; background:transparent; border:1px solid var(--rule); color:var(--ink); font-size:18px; cursor:pointer; line-height:1;}
  .m-close:hover{border-color:var(--ink);}
  .m-group{font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--teal); margin-bottom:8px;}
  .m-panel h3{font-weight:800; font-size:30px; letter-spacing:-.015em; margin:0 40px 14px 0;}
  .m-live{display:flex; align-items:baseline; justify-content:space-between; gap:14px; border-block:1px solid var(--rule); padding:14px 0; margin-bottom:18px;}
  .m-live span{color:var(--ink-dim); font-size:14px;}
  .m-live b{font-family:var(--mono); font-weight:600; font-size:22px; color:var(--accent-ink); font-variant-numeric:tabular-nums; text-align:right;}
  .m-panel p{color:var(--ink-dim); margin-bottom:14px;}
  .m-panel code{display:block; font-family:var(--mono); font-size:13px; color:var(--accent-ink); background:var(--surface-2); padding:10px 12px; overflow-wrap:anywhere;}
  .toast{position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); z-index:80; transform:translate(-50%,20px); opacity:0; pointer-events:none;
    background:var(--ink); color:var(--ground); font-family:var(--display); font-weight:600; font-size:14px; padding:12px 18px; transition:opacity .25s, transform .3s cubic-bezier(.2,.8,.2,1); max-width:calc(100% - 32px);}
  .toast.show{opacity:1; transform:translate(-50%,0);}

  /* ---------- Scroll reveal ---------- */
  .js .rv{transition:opacity .7s ease, transform .7s cubic-bezier(.2,.8,.2,1); transition-delay:var(--d,0s);}
  .js .rv:not(.in){opacity:.3; transform:translateY(28px) scale(.985);}

  /* ====================================================================
     Calculator (device frame). Always dark, as in the original design.
     ==================================================================== */
  .calc{
    --bg:#000000; --panel:#0D0D0D; --panel-2:#1A1A1A; --line:#333333;
    --text:#FFFFFF; --text-dim:#9A9A9A;
    --molten:#FFFFFF; --molten-soft:rgba(255,255,255,0.10); --molten-light:#FFFFFF;
    --patina:#BDBDBD; --neg:#8C8C8C;
    --r-sm:4px; --r-md:8px; --r-pill:999px;
    color-scheme:dark;
    position:relative; width:100%; max-width:420px; height:700px; overflow:hidden; isolation:isolate;
    border:1px solid var(--rule); border-radius:28px;
    background:radial-gradient(720px 320px at 50% -80px, rgba(255,255,255,0.10), transparent 65%), var(--bg);
    color:var(--text); font-family:'Barlow',system-ui,sans-serif; font-size:16px; line-height:1.4;
  }
  .calc *{box-sizing:border-box;}
  .calc button{font-family:inherit;}
  .calc .screen{position:absolute; inset:0; overflow-y:auto; padding:20px 14px 112px; scrollbar-width:thin;}

  .calc .c-head{margin-bottom:16px; animation:rise .6s cubic-bezier(.2,.7,.3,1) both;}
  @keyframes rise{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;} }
  .calc .eyebrow{font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:12px; letter-spacing:.10em; color:var(--patina); margin-bottom:4px;}
  .calc .c-title{font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:30px; line-height:1.05; margin:0 0 6px; color:var(--text);}
  .calc .sub{color:var(--text-dim); font-size:13.5px; line-height:1.5; margin:0;}

  .calc .rail-label{font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:13px; color:var(--text-dim); margin:20px 0 8px;}
  .calc .rail-outer{position:relative;}
  .calc .rail{position:relative; display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding:4px 2px 10px;}
  .calc .rail::-webkit-scrollbar{display:none;}
  .calc .rail-indicator{
    position:absolute; top:4px; height:38px; background:var(--molten); border-radius:var(--r-pill);
    transition:left .32s cubic-bezier(.2,.8,.2,1), width .32s cubic-bezier(.2,.8,.2,1); z-index:0;
  }
  .calc .chip{
    position:relative; z-index:1; flex:0 0 auto; font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:14.5px;
    color:var(--text-dim); background:transparent; border:1px solid var(--line); padding:8px 16px; border-radius:var(--r-pill);
    cursor:pointer; transition:color .25s ease, border-color .25s ease; white-space:nowrap;
  }
  .calc .chip.active{color:#000000; border-color:transparent;}
  .calc .process-note{font-size:12.5px; color:var(--text-dim); line-height:1.5; margin:2px 0 14px; min-height:38px;}

  .calc .panel{background:var(--panel); border:1px solid var(--line); border-radius:var(--r-md); padding:14px 14px 16px; margin-bottom:14px;}
  .calc .panel-title{font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:15px; color:var(--text); margin:0 0 12px;}
  .calc label{display:block; font-size:12px; color:var(--text-dim); margin:12px 0 5px;}
  .calc label:first-of-type{margin-top:0;}
  .calc select,.calc input[type=number],.calc input[type=text]{
    width:100%; background:var(--panel-2); border:1px solid var(--line); color:var(--text);
    font-family:'Barlow',sans-serif; font-size:14.5px; padding:10px 11px; border-radius:var(--r-sm); appearance:none; -webkit-appearance:none;
  }
  .calc .row2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .calc .picker-btn{
    width:100%; display:flex; justify-content:space-between; align-items:center; gap:10px;
    background:var(--panel-2); border:1px solid var(--line); color:var(--text); font-size:14.5px; padding:11px 12px; border-radius:var(--r-sm); cursor:pointer; text-align:left;
  }
  .calc .picker-btn .val{color:var(--text); min-width:0;}
  .calc .picker-btn .shrink-tag{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--patina); white-space:nowrap;}
  .calc .seg{display:flex; gap:8px;}
  .calc .seg button{
    flex:1; background:var(--panel-2); border:1px solid var(--line); color:var(--text-dim); font-size:13.5px; padding:9px 6px;
    border-radius:var(--r-sm); cursor:pointer; transition:.2s ease;
  }
  .calc .seg button.active{background:var(--molten-soft); border-color:var(--molten); color:var(--molten-light); font-weight:600;}

  .calc .chain-title{font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:15px; color:var(--text); margin:0 0 4px;}
  .calc .chain-sub{font-size:12px; color:var(--text-dim); margin-bottom:12px;}
